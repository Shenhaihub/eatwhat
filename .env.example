# EatWhat 环境变量示例。复制为 .env 并填写真实值；.env 不入库。
# 本项目严禁把真实 Secret 写入前端或 Git。

# ============================================================
# EatWhat 环境变量示例（复制为 .env 并填写；.env 不入库）
# ⚠️ Key 类型判别（避免 Invalid API key）：
#   - Supabase 原生 anon / service_role key：JWT 格式（eyJ... 开头）
#       → 来自 Supabase 控制台 Project Settings → API → Project API keys
#   - sb_publishable_ / sb_secret_ 前缀：第三方发布平台 key
#       → 不是 Supabase API key，填到 VITE_SUPABASE_ANON_KEY 会导致 /auth/v1/token 401
# ============================================================

# --- 前端（仅可公开值；以 VITE_ 前缀暴露给浏览器） ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_MODE=mock
# Project URL（格式 https://<project-ref>.supabase.co，公开可分享）
VITE_SUPABASE_URL=
# Supabase 原生 anon key（eyJ... 开头；可公开，受 RLS 约束）
VITE_SUPABASE_ANON_KEY=

# --- 后端 ---
APP_ENV=development
APP_MODE=mock
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# ⚠️ service_role key（eyJ... 开头；后端专用，绕过 RLS；绝对禁止进前端 / Git / 日志）
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
POI_PROVIDER=mock
AMAP_API_KEY=
AI_DAILY_USER_LIMIT=3
AI_GLOBAL_DAILY_LIMIT=100
POI_CACHE_TTL_SECONDS=1200
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
