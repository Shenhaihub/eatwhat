# EatWhat 环境变量示例。复制为 .env 并填写真实值；.env 不入库。
# 本项目严禁把真实 Secret 写入前端或 Git。

# --- 前端（仅可公开值；以 VITE_ 前缀暴露给浏览器） ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_MODE=mock
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- 后端 ---
APP_ENV=development
APP_MODE=mock
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
POI_PROVIDER=mock
AMAP_API_KEY=
AI_DAILY_USER_LIMIT=3
AI_GLOBAL_DAILY_LIMIT=100
POI_CACHE_TTL_SECONDS=1200
FRONTEND_ORIGINS=http://localhost:5173
