# EatWhat Frontend 环境变量示例（开发模式用）
# 复制为 .env.local 并填写真实值；.env.local 不入库。
# Docker 构建不需要此文件——nginx 反代 /api/* → backend:8000，API 走相对路径。

# 后端 API 基础地址（开发模式用，默认 /api/v1 走 vite proxy）
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase 配置（登录功能需要；Mock 模式留空即可）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
