# EatWhat 后端环境变量示例（复制为 backend/.env 并填写真实值；.env 不入库）
# 完整说明见根目录 .env.example；真实 Secret 严禁进入 Git 或前端。

APP_ENV=development
APP_MODE=mock

DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=

AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_DAILY_USER_LIMIT=3
AI_GLOBAL_DAILY_LIMIT=100
AI_MAX_RETRIES=1

POI_PROVIDER=mock
AMAP_API_KEY=
POI_CACHE_TTL_SECONDS=1200

FRONTEND_ORIGINS=http://localhost:5173
PUBLIC_MIN_SAMPLE_SIZE=3
