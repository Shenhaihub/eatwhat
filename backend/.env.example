# EatWhat 后端环境变量示例（复制为 backend/.env 并填写真实值；.env 不入库）
# 完整说明见根目录 .env.example；真实 Secret 严禁进入 Git 或前端。

APP_ENV=development
APP_MODE=mock

DATABASE_URL=

# ============================================================
# P4 Supabase（账户/历史/数据库唯一真源）
# ============================================================
# Project URL，格式 https://<project-ref>.supabase.co
SUPABASE_URL=
# Anon Key（前端可读；可公开，不受 RLS 影响）
SUPABASE_ANON_KEY=
# Service Role Key（⚠️ 后端专用，绕过 RLS；绝对禁止写入前端 / Git / 日志）
SUPABASE_SERVICE_ROLE_KEY=

# （可选）自定义 JWKS URL，留空默认用 {SUPABASE_URL}/auth/v1/jwks
SUPABASE_JWKS_URL=
# （可选）JWT iss/aud 校验，留空按默认推导
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

AI_PROVIDER=mock
# =========================================
# P5 AI Provider（选型已确认：DeepSeek V4 Flash）
# ⚠️ 安全底线 — 请严格遵守，否则会导致密钥泄漏 ⚠️
#
# 1) 明文 AI API Key 绝对不能写在这里。必须先运行加密工具得到 ENC: 前缀的密文，再粘进来。
#    加密工具：cd backend && uv run python scripts/encrypt_ai_key.py
#    流程：输入口令（EW_AI_KEY_PASSPHRASE，建议密码管理器生成 32+ 随机字符）
#          → 粘贴 sk-... 明文 → 工具输出 ENC:<Fernet-Token> 一整行
#          → 把这一整行（含 ENC: 前缀）粘贴在下面 AI_API_KEY= 之后
#    加密算法：Fernet(AES-128-CBC+HMAC-SHA256)；密钥从口令 PBKDF2HMAC 派生，48 万次迭代。
#
# 2) AI_API_KEY 与 EW_AI_KEY_PASSPHRASE 必须分别填写，两个一起才能解密。
#    即使 .env 文件被整份窃取，没有口令也无法还原明文 sk-...。
#
# 3) 留空 AI_API_KEY = 强制使用 Mock（默认值，开箱即用无 AI 成本）。
#
# 取值 AI_PROVIDER：
#   - mock      : 纯 MockAIProvider + 规则引擎（无外部网络调用，开发/UI 默认）
#   - deepseek  : 强制 DeepSeek Live（AI_API_KEY 必须已配置，否则期启动 fail-fast）
#   - auto      : 优先 DeepSeek Live；单次失败或未配置时 request-level 自动回退 Mock
AI_API_KEY=

# 🔑 解密口令：至少 12 字符（强烈建议 32+，密码管理器生成，不要与任何账号复用）
EW_AI_KEY_PASSPHRASE=

# （极少用）PBKDF2 salt 覆盖。默认使用项目级内置 salt，个人 demo 不需要改。
EW_AI_SALT=

# 模型名（OpenAI 兼容）：DeepSeek 官方最便宜 V4 Flash（中文友好，0.27 元/百万 token 输入）
AI_MODEL=deepseek-v4-flash

# 额度/限流（P5-05 配额账本实现后实际生效；当前仅记录配置）
AI_DAILY_USER_LIMIT=3
AI_GLOBAL_DAILY_LIMIT=100
AI_MAX_RETRIES=1

# ============================================================
# P3 POI Provider（高德 / Mock / auto 降级）
# ============================================================
# POI_PROVIDER 取值：
#   - mock：仅使用本地 Mock 数据（四态可切，适合 UI 联调）
#   - auto：优先高德 Live；密钥缺失或 Live 连续失败时自动降级 Mock
#   - live：强制高德 Live（AMAP_API_KEY 为空启动失败，fail-fast）
POI_PROVIDER=auto

# 高德 Web 服务 Key（Web 服务类型，后端读取，不出前端）
# 申请：https://console.amap.com/dev/key/app
AMAP_API_KEY=

# POI 搜索缓存 TTL（秒）。默认 20 分钟，控制高德 QPS
POI_CACHE_TTL_SECONDS=1200

# Mock 模式 UI 调试（可选，请求体 mock_mode 参数优先）：
#   normal | empty | slow | error
POI_MOCK_MODE=normal
# Mock slow 模式下响应延迟毫秒（默认 2000）
POI_MOCK_SLOW_MS=2000

FRONTEND_ORIGINS=http://localhost:5173
PUBLIC_MIN_SAMPLE_SIZE=3
