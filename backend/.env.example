# =============================================================================
# EatWhat Backend .env.example（生产/开发通用环境变量模板）
# =============================================================================
# 用法：
#   1. 复制本文件为 backend/.env   （Windows:  copy .env.example .env
#                                   Linux/mac: cp .env.example .env）
#   2. 逐个填写下方 XXX 占位的值；不需要的功能留空即可。
#   3. ⚠️  绝对不要把 .env 提交到 git！本项目 .gitignore 已全局忽略 .env 文件。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 运行环境（AppEnv / AppMode）
# -----------------------------------------------------------------------------
APP_ENV=development                    # development | test | production
APP_MODE=mock                          # mock = 纯本地（开发/调试）；live = 启用真实第三方服务（Supabase/高德/AI 等）


# -----------------------------------------------------------------------------
# 2. Supabase 账户与鉴权（路径 A、History RLS、GDPR 删除必须）
# -----------------------------------------------------------------------------
SUPABASE_URL=                         # 例如 https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=                    # anon public key（可给前端）
SUPABASE_SERVICE_ROLE_KEY=            # service_role key（**只给后端，绝不泄漏到前端**）
SUPABASE_JWKS_URL=                    # 一般自动推断：${SUPABASE_URL}/auth/v1/.well-known/jwks.json
                                      # 自定义域名部署时需手动填写完整 URL
SUPABASE_JWT_ISSUER=                  # JWT iss 校验：一般等于 ${SUPABASE_URL}/auth/v1
SUPABASE_JWT_AUDIENCE=                # JWT aud 校验：一般填 "authenticated"
DATABASE_URL=                         # Supabase 直连 PostgreSQL 串（可选；若只走 Supabase REST SDK 可以不填）


# -----------------------------------------------------------------------------
# 3. AI Provider（P5 动态 AI 链路；选型：DeepSeek V4 Flash）
#    🔐 安全红线：AI_API_KEY **绝对禁止明文 sk-... 直接写入**
#       必须先跑加密脚本 → 得到 ENC: 开头的密文串再填
# -----------------------------------------------------------------------------
# 生成方式（二选一，在 backend/ 目录执行）：
#   · 一键模式（推荐，自动生成强口令+盐+密文）：
#         uv run python scripts/encrypt_ai_key.py -a
#   · 自己提供口令模式：
#         uv run python scripts/encrypt_ai_key.py

AI_PROVIDER=mock                      # mock（默认，不消耗额度）
                                      # deepseek（启用真实 DeepSeek V4 Flash HTTP）
                                      # auto（优先 deepseek；未配置自动回 mock，用户无感）

AI_API_KEY=                           # 密文，ENC:<Fernet-Token>；留空 = 不启用 live AI
EW_AI_KEY_PASSPHRASE=                 # 解密口令（≥12 字符；建议 32+ 随机，密码管理器保存）
EW_AI_SALT=                           # （可选）PBKDF2 salt；留空 = 自动每次新盐，安全性相同
AI_MODEL=deepseek-v4-flash            # 模型名；官方最便宜 V4 Flash（OpenAI 兼容格式）

# MockAIProvider 调试（只在 AI_PROVIDER=mock / auto+未配置时生效）
MOCK_AI_MODE=normal                   # normal / slow（9s 超时模拟）/ invalid_json / out_of_bounds_food_code
MOCK_AI_SEED=0                        # 0..10000；normal 模式下扰动 Top5 排序（MEM-024）

# AI 日维度限流（P5-07；0 = 不限制该维度）
AI_DAILY_USER_LIMIT=50                # 单用户每日最多 N 次真实 AI 调用；超了自动切规则引擎
AI_GLOBAL_DAILY_LIMIT=5000            # 全服每日最多 N 次；超了自动切规则引擎
AI_MAX_RETRIES=1                      # （预留）AI HTTP 失败重试次数；当前 fail-open，不启用重试


# -----------------------------------------------------------------------------
# 4. POI（餐馆位置查询；mock=本地假数据，live=高德）
# -----------------------------------------------------------------------------
POI_PROVIDER=mock                     # mock | live | auto
AMAP_API_KEY=                         # 高德开放平台 Web 服务 API Key
POI_CACHE_TTL_SECONDS=1200            # 本地假数据/TLL 缓存秒数（20 分钟）


# -----------------------------------------------------------------------------
# 5. Redis（P5-07B 多 worker/多机器严格限流）
#    · 不填 = 降级到进程内 TTLCache（单机单 worker 场景 OK，多 worker 会变成
#      实际限额 = 配置值 × worker 数量，属于保守退化，不会炸）
#    · 生产推荐填写；单机 Redis 足够承担限流计数的 QPS
# -----------------------------------------------------------------------------
REDIS_URL=                            # 留空 = 不用 Redis；示例：redis://localhost:6379/0


# -----------------------------------------------------------------------------
# 6. CORS / 安全
# -----------------------------------------------------------------------------
FRONTEND_ORIGINS=http://localhost:5173 # 允许的前端 Origin；多个用英文逗号分隔，无空格
PUBLIC_MIN_SAMPLE_SIZE=3              # 公开聚合统计的最小样本量（差分隐私阈值）


# =============================================================================
# 校验 & 启动
# =============================================================================
# 本文件修改后，请在 backend/ 目录运行：
#
#   1. 语法与字段级校验（pydantic-settings 会在启动期 fail-fast）：
#         uv run python -c "from app.core.config import Settings; s = Settings(); print('OK', s.app_env, s.ai_provider)"
#
#   2. 如果报错 "AI_API_KEY 疑似明文"：请先使用 scripts/encrypt_ai_key.py 加密。
#
#   3. 全单测：
#         uv run pytest -q
#
#   4. 后端 dev server：
#         uv run uvicorn app.main:app --reload --port 8000
